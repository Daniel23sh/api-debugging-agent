OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol
OPENAI_REASONING_EFFORT=medium
EVAL_JUDGE_MODEL=gpt-6.1-sol
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006
PHOENIX_PROJECT_NAME=apilens
OTEL_SERVICE_NAME=apilens-agent-service
SANDBOX_BASE_URL=http://127.0.0.1:8000
SANDBOX_DATABASE_PATH=sandbox.db

# Compose supplies container addresses and storage paths; host settings above stay local.
# Uncomment to disable trace export in Docker (unset uses http://phoenix:6006).
# DOCKER_PHOENIX_COLLECTOR_ENDPOINT=
